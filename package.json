{
  "name": "@sednalabs/cloudflare-browser-provider",
  "version": "0.2.0",
  "description": "Codex native browser provider backed by Cloudflare Browser Run",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.4",
  "bin": {
    "cloudflare-browser-provider": "dist/cli/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./contract": "./dist/contract/index.js"
  },
  "files": [
    "dist/",
    "LICENSE",
    "NOTICE",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run test:coverage && npm run build && npm run pack:check",
    "deploy": "wrangler deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "pack:check": "npm pack --dry-run",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "worker:types": "wrangler types"
  },
  "dependencies": {
    "@cloudflare/playwright": "1.3.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260710.1",
    "@eslint/js": "9.39.4",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.4",
    "globals": "17.7.0",
    "prettier": "3.9.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0",
    "vitest": "4.1.10",
    "wrangler": "4.110.0"
  }
}
